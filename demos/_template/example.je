import io
import math

import pandas as pd
import plotly.graph_objects as go
import streamlit as st

st.set_page_config(
    page_title="{{프로젝트 제목}}",
    page_icon="📊",
    layout="wide",
)

st.title("📊 {{프로젝트 제목}}")
st.caption("{{한 줄 요약}}")


def read_csv_any(uploaded_file) -> pd.DataFrame:
    raw = uploaded_file.read()
    for enc in ("utf-8-sig", "cp949", "euc-kr", "utf-8"):
        try:
            return pd.read_csv(io.BytesIO(raw), encoding=enc)
        except Exception:
            continue
    return pd.read_csv(io.BytesIO(raw), encoding="utf-8", errors="replace")


with st.sidebar:
    st.header("📂 데이터 업로드")
    uploaded = st.file_uploader("CSV 파일", type=["csv"])
    st.markdown(
        """
        **필수 컬럼**
        - `학생이름`
        - `친한친구이름`
        - `친한이유`
        - `서먹한친구이름`
        - `서먹한이유`

        샘플 파일: `sample_data.csv`
        """
    )

if uploaded is None:
    st.info("👈 왼쪽 사이드바에서 CSV 파일을 업로드하세요.")
    st.stop()

df = read_csv_any(uploaded)


st.subheader("① 데이터 확인")
st.dataframe(df, use_container_width=True, hide_index=True)


st.subheader("② 친구 관계 네트워크 그래프")

REQUIRED_COLS = ["학생이름", "친한친구이름", "친한이유", "서먹한친구이름", "서먹한이유"]
missing = [c for c in REQUIRED_COLS if c not in df.columns]
if missing:
    st.error(f"필수 컬럼 누락: {missing}")
    st.stop()

nodes = set()
edges_positive = []
edges_negative = []

for idx, row in df.iterrows():
    student = str(row["학생이름"]).strip() if pd.notna(row["학생이름"]) else None
    close_friend = str(row["친한친구이름"]).strip() if pd.notna(row["친한친구이름"]) else None
    close_reason = str(row["친한이유"]).strip() if pd.notna(row["친한이유"]) else ""
    distant_friend = str(row["서먹한친구이름"]).strip() if pd.notna(row["서먹한친구이름"]) else None
    distant_reason = str(row["서먹한이유"]).strip() if pd.notna(row["서먹한이유"]) else ""
    
    if student and student != "nan":
        nodes.add(student)
    if close_friend and close_friend != "nan":
        nodes.add(close_friend)
    if distant_friend and distant_friend != "nan":
        nodes.add(distant_friend)
    
    if student and close_friend and close_friend != "nan":
        edges_positive.append({"source": student, "target": close_friend, "reason": close_reason})
    
    if student and distant_friend and distant_friend != "nan":
        edges_negative.append({"source": student, "target": distant_friend, "reason": distant_reason})

if not nodes:
    st.error("⚠️ 데이터에서 학생 정보를 찾을 수 없습니다.")
    st.stop()

nodes_list = sorted(list(nodes))
node_indices = {node: idx for idx, node in enumerate(nodes_list)}

fig = go.Figure()

angles = [2 * math.pi * i / len(nodes_list) for i in range(len(nodes_list))]
node_x = [150 * math.cos(angle) for angle in angles]
node_y = [150 * math.sin(angle) for angle in angles]

x_edges_pos = []
y_edges_pos = []
for edge in edges_positive:
    source_idx = node_indices[edge["source"]]
    target_idx = node_indices[edge["target"]]
    x_edges_pos.extend([node_x[source_idx], node_x[target_idx], None])
    y_edges_pos.extend([node_y[source_idx], node_y[target_idx], None])

if x_edges_pos:
    fig.add_trace(go.Scatter(
        x=x_edges_pos, y=y_edges_pos,
        mode='lines',
        line=dict(width=2, color='#3498db'),
        hoverinfo='none',
        showlegend=False,
    ))

x_edges_neg = []
y_edges_neg = []
for edge in edges_negative:
    source_idx = node_indices[edge["source"]]
    target_idx = node_indices[edge["target"]]
    x_edges_neg.extend([node_x[source_idx], node_x[target_idx], None])
    y_edges_neg.extend([node_y[source_idx], node_y[target_idx], None])

if x_edges_neg:
    fig.add_trace(go.Scatter(
        x=x_edges_neg, y=y_edges_neg,
        mode='lines',
        line=dict(width=2, color='#e74c3c', dash='dash'),
        hoverinfo='none',
        showlegend=False,
    ))

node_hover = []
for node in nodes_list:
    close_reasons = [e["reason"] for e in edges_positive if e["source"] == node and e["reason"]]
    distant_reasons = [e["reason"] for e in edges_negative if e["source"] == node and e["reason"]]
    
    hover_text = f"<b>{node}</b>"
    if close_reasons:
        hover_text += f"<br>친한 친구: {', '.join(close_reasons)}"
    if distant_reasons:
        hover_text += f"<br>서먹한: {', '.join(distant_reasons)}"
    
    node_hover.append(hover_text)

fig.add_trace(go.Scatter(
    x=node_x, y=node_y,
    mode='markers+text',
    text=nodes_list,
    textposition="top center",
    hovertext=node_hover,
    hoverinfo='text',
    marker=dict(size=25, color='#2ecc71', line=dict(width=2, color='#27ae60')),
    showlegend=False,
))

fig.add_trace(go.Scatter(x=[None], y=[None], mode='lines',
    line=dict(color='#3498db', width=2), name='친한 친구'))
fig.add_trace(go.Scatter(x=[None], y=[None], mode='lines',
    line=dict(color='#e74c3c', width=2, dash='dash'), name='서먹한 친구'))

fig.update_layout(
    title="학급 친구 관계도",
    showlegend=True,
    hovermode='closest',
    margin=dict(b=0, l=0, r=0, t=40),
    xaxis=dict(showgrid=False, zeroline=False, showticklabels=False),
    yaxis=dict(showgrid=False, zeroline=False, showticklabels=False),
    plot_bgcolor='#f8f9fa',
    height=600,
)

st.plotly_chart(fig, use_container_width=True)

col1, col2 = st.columns(2)
with col1:
    st.info("🔵 **실선**: 친한 친구 관계")
with col2:
    st.info("🔴 **점선**: 서먹한 친구 관계")


st.subheader("③ (작성 예정)")
st.write("Copilot에게: '기능 3을 추가해줘'")
